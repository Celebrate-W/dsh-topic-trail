# 依赖与构建产物
node_modules/
*.log

# 运行时数据（含会话标题等隐私，绝不入库）
data/
*.json.gz
topic-trail.bak-*/
dsh-topic-trail.srcbak-*/

# 本地开发/调试脚本（含本机路径与本地会话 ID）
.debug-*.mjs
.check-*.mjs
.preview-*.mjs
.test-*.mjs
.start-test.ps1
.verify*.mjs
# 其余以点开头的临时脚本（.selftest / .frontcheck / .skincheck …）
# 用通配收口，免得新写的调试脚本每加一个就冒进 git status
.*.mjs
.*.cjs
.*.ps1
*.tmp

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
