{
  "name": "dsh-topic-trail",
  "version": "0.1.0",
  "description": "会话工作线索悬浮窗：用 DeepSeek 把用户与 AI 的会话实时提炼成话题（线索）与进度步骤，在 Web UI 中显示为可拖动的悬浮窗。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "使用说明.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "topic",
    "trail",
    "overlay"
  ],
  "author": "Celebrate-W",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Celebrate-W/dsh-topic-trail.git"
  },
  "homepage": "https://github.com/Celebrate-W/dsh-topic-trail#readme",
  "bugs": {
    "url": "https://github.com/Celebrate-W/dsh-topic-trail/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
